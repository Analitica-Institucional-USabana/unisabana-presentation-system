{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unisabana:schemas:deck-spec:0.1.0",
  "title": "Universidad de La Sabana — Deck Spec",
  "$comment": "Hito 4 (planning/03-migration-roadmap.md). Representación intermedia declarativa: el agente (skill unisabana-create) produce una instancia de este esquema; core/brand/rules/*.json y el futuro validators/ (Hito 6) la comprueban antes de renderizar. Consolida dos taxonomías de la fuente original: las 10 familias narrativas de claude-design-system/readme.md §9 (cover, agenda, section-separator, message, data, comparison, process/timeline, table/technical, quote, closing) y los 10 ejemplos de claude-design-system/slides/*.html — 'photo-cover' se modela como cover{background:photo} y 'dashboard' como table{density:high}, sin perder ninguna de las dos.\n\nPolítica de evolución (SemVer del esquema, independiente del SemVer del plugin): PATCH = aclaraciones que no cambian validación; MINOR = campos nuevos opcionales o un nuevo valor de enum aditivo; MAJOR = cualquier campo requerido nuevo, cualquier remoción, o cualquier restricción de un enum existente. Un campo nunca se elimina sin pasar primero por un aviso 'deprecated' en su description durante al menos una versión MINOR.",
  "type": "object",
  "required": ["schemaVersion", "presentation", "slides"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["0.1.0"],
      "description": "Versión del propio esquema del Deck Spec (no la versión del plugin ni la de core/brand)."
    },
    "presentation": { "$ref": "#/$defs/presentation" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },

  "$defs": {
    "presentation": {
      "type": "object",
      "required": ["title", "density", "palette"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "string",
          "description": "Descripción libre de la audiencia (ej. 'Consejo Directivo', 'Facultad de Ingeniería'). No es un campo de cumplimiento de marca, es contexto para la creatividad del agente."
        },
        "density": {
          "type": "string",
          "enum": ["low", "high"],
          "description": "Corresponde a core/brand/rules/density.json#/modes. 'low' = ejecutiva (60-80% de llenado), 'high' = técnica (80-90%)."
        },
        "palette": {
          "type": "string",
          "enum": [
            "institutional",
            "ingenieria", "comportamiento", "educacion", "medicina", "juridicas", "cta",
            "lenguas", "vida", "filosofia", "comunicacion", "familia", "forum", "economicas"
          ],
          "description": "Única para todo el deck (core/brand/rules/palette.json#/rules/no-mixing) — por eso vive aquí y no por slide."
        }
      }
    },

    "slide": {
      "type": "object",
      "required": ["id", "type"],
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        { "$ref": "#/$defs/slideCover" },
        { "$ref": "#/$defs/slideAgenda" },
        { "$ref": "#/$defs/slideSeparator" },
        { "$ref": "#/$defs/slideMessage" },
        { "$ref": "#/$defs/slideData" },
        { "$ref": "#/$defs/slideComparison" },
        { "$ref": "#/$defs/slideProcess" },
        { "$ref": "#/$defs/slideTable" },
        { "$ref": "#/$defs/slideQuote" },
        { "$ref": "#/$defs/slideClosing" }
      ]
    },

    "slideIdAndNotes": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Slug único dentro del deck, ej. 'cover-01'." },
      "notes": { "type": "string", "description": "Notas de orador, opcional. No se renderiza en el slide." }
    },

    "statItem": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "delta": { "type": "string" },
        "deltaDirection": { "type": "string", "enum": ["up", "down"] },
        "caption": { "type": "string" },
        "accent": { "$ref": "#/$defs/statusAccent" },
        "badge": { "type": "string", "minLength": 1, "description": "Etiqueta corta de esquina, ej. 'Alerta principal · 15%'." }
      }
    },

    "statusAccent": {
      "type": "string",
      "enum": ["neutral", "alert"],
      "description": "'alert' reutiliza el rojo ya aprobado de la paleta fac-juridicas (core/brand/tokens.css) para señalar un riesgo/problema real — no es un valor decorativo, ver skills/unisabana-create/references/slide-families.md."
    },

    "emphasisBanner": {
      "type": "object",
      "required": ["variant", "text"],
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["info", "warning", "highlight"],
          "description": "Franja de énfasis de ancho completo (planning/09-visual-richness-and-content-density.md #1). 'info' = navy, apertura/conclusión fuerte. 'warning' = ámbar/crema, advertencia. 'highlight' = tinte claro, dato secundario relevante."
        },
        "text": { "type": "string", "minLength": 1, "description": "Una cifra o una frase corta, no un párrafo." },
        "label": { "type": "string", "description": "Etiqueta corta en mayúsculas opcional, ej. 'NOTA', 'PUNTO DE PARTIDA'." },
        "icon": { "type": "string", "minLength": 1, "description": "Slug opcional del set vendorizado en core/brand/rules/icons.json#/approvedIcons; whitelist validada en tiempo de deck-spec (validators/rules/icons.mjs), no enumerada aquí." }
      }
    },

    "slideCover": {
      "type": "object",
      "required": ["id", "type", "title", "background"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "cover" },
        "title": { "type": "string", "minLength": 1, "description": "Orientado a mensaje, no a etiqueta (readme.md §Voice & tone)." },
        "subtitle": { "type": "string" },
        "eyebrow": { "type": "string" },
        "background": {
          "type": "string",
          "enum": ["light", "navy", "photo"],
          "description": "'photo' = equivalente al ejemplo histórico slides/08-photo-cover.html."
        },
        "photo": {
          "type": "string",
          "description": "Ruta relativa dentro de core/brand/rules/imagery.json#/approvedCampusPhotography. Requerido si background='photo'."
        },
        "presenter": { "type": "string" },
        "date": { "type": "string" },
        "event": { "type": "string" }
      },
      "if": { "properties": { "background": { "const": "photo" } } },
      "then": { "required": ["photo"] }
    },

    "slideAgenda": {
      "type": "object",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "agenda" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "core/brand/rules/density.json#/slideContentLimits/maxAgendaItemsPreferred recomienda 3-6; no es un tope estructural duro."
        }
      }
    },

    "slideSeparator": {
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "separator" },
        "sectionNumber": { "type": ["string", "number"] },
        "title": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string" }
      }
    },

    "slideMessage": {
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "message" },
        "title": { "type": "string", "minLength": 1, "description": "La conclusión central." },
        "supporting": { "type": "string", "description": "Frase de apoyo o prueba, opcional." },
        "banner": { "$ref": "#/$defs/emphasisBanner" }
      }
    },

    "slideData": {
      "type": "object",
      "required": ["id", "type", "title", "stats", "source", "period"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "data" },
        "title": { "type": "string", "minLength": 1, "description": "Orientado a conclusión, no a etiqueta." },
        "stats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/statItem" }
        },
        "source": { "type": "string", "minLength": 1, "description": "Obligatorio en slides de datos (readme.md §9.5)." },
        "period": { "type": "string", "minLength": 1 },
        "banner": { "$ref": "#/$defs/emphasisBanner" }
      }
    },

    "slideComparison": {
      "type": "object",
      "required": ["id", "type", "title", "columns"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "comparison" },
        "title": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "description": "core/brand/rules/density.json#/slideContentLimits/maxColumns = 3.",
          "items": {
            "type": "object",
            "required": ["heading", "points"],
            "additionalProperties": false,
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "points": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "accent": { "$ref": "#/$defs/statusAccent" },
              "badge": { "type": "string", "minLength": 1, "description": "Etiqueta corta de esquina, ej. '30% del ranking'." },
              "stats": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "description": "Convierte la columna en tarjeta de comparación con estado (planning/09-visual-richness-and-content-density.md #2): hasta 2 cifras grandes lado a lado sobre los bullets de 'points'.",
                "items": { "$ref": "#/$defs/statItem" }
              }
            }
          }
        }
      }
    },

    "slideProcess": {
      "type": "object",
      "required": ["id", "type", "title", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "process" },
        "title": { "type": "string", "minLength": 1 },
        "banner": { "$ref": "#/$defs/emphasisBanner" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "description": "core/brand/rules/density.json#/slideContentLimits/maxProcessStepsPreferred recomienda 3-6.",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "slideTable": {
      "type": "object",
      "required": ["id", "type", "title", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "table" },
        "title": { "type": "string", "minLength": 1 },
        "density": {
          "type": "string",
          "enum": ["low", "high"],
          "default": "low",
          "description": "'high' = equivalente al ejemplo histórico slides/10-dashboard.html."
        },
        "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "highlightCells": {
          "type": "array",
          "description": "Coordenadas [fila, columna] (0-index) a resaltar — solo los valores necesarios para el mensaje.",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },

    "slideQuote": {
      "type": "object",
      "required": ["id", "type", "text", "attribution"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },

    "slideClosing": {
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slideIdAndNotes/id" },
        "notes": { "$ref": "#/$defs/slideIdAndNotes/notes" },
        "type": { "const": "closing" },
        "title": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    }
  }
}
