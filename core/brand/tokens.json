{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_provenance": "Extraído de claude-design-system/tokens/{colors,typography,spacing,fonts}.css el 2026-07-23 (Hito 1). Fuente original citada en esos archivos: BRAND-GUIDELINES-VF.pdf (institucional) + AF-PLANTILLA PPT GENERA-3.pptx slide 42 (paletas de facultad). No se inventó ningún valor; este archivo es la fuente única de la que tokens.css se genera como proyección.",
  "color": {
    "institutional": {
      "sabana-blue": { "value": "#00205B", "note": "Pantone 281 · azul primario de marca" },
      "sabana-blue-deep": { "value": "#0D2157", "note": "navy de fondo de portadas/separadores (uso de plantilla)" },
      "sabana-blue-mid": { "value": "#003A86", "note": "Pantone 286 · azul secundario" },
      "sabana-blue-300": { "value": "#98B1D3", "note": "Pantone 292 · azul claro" },
      "sabana-blue-100": { "value": "#DCE5F3", "note": "Pantone 2707 · superficie azul pálido" },
      "sabana-cream": { "value": "#FAF3DC", "note": "Pantone 7499 · acento cálido" }
    },
    "neutrals": {
      "ink-900": { "value": "#000000" },
      "ink-700": { "value": "#3C3C3B" },
      "ink-500": { "value": "#717175" },
      "ink-300": { "value": "#99989D" },
      "ink-200": { "value": "#C2C3C8" },
      "paper": { "value": "#FFFFFF" }
    },
    "semantic": {
      "bg-page": { "ref": "color.neutrals.paper" },
      "bg-inverse": { "ref": "color.institutional.sabana-blue-deep" },
      "surface-tint": { "ref": "color.institutional.sabana-blue-100" },
      "surface-cream": { "ref": "color.institutional.sabana-cream" },
      "border-subtle": { "ref": "color.neutrals.ink-200" },
      "text-strong": { "ref": "color.institutional.sabana-blue" },
      "text-body": { "ref": "color.neutrals.ink-700" },
      "text-muted": { "ref": "color.neutrals.ink-500" },
      "text-on-dark": { "ref": "color.neutrals.paper" }
    },
    "accent": {
      "_note": "Paleta activa. Por defecto es la institucional; un data-faculty la repunta a la paleta de esa facultad. Nunca mezclar dos facultades en un mismo deck.",
      "default": {
        "accent": { "ref": "color.institutional.sabana-blue" },
        "accent-dark": { "ref": "color.institutional.sabana-blue-deep" },
        "accent-mid": { "ref": "color.institutional.sabana-blue-mid" },
        "accent-300": { "ref": "color.institutional.sabana-blue-300" },
        "accent-100": { "ref": "color.institutional.sabana-blue-100" }
      }
    },
    "faculties": {
      "_note": "13 paletas facultad/unidad. Escala 700 (oscuro) · 500 (principal) · 300 (60%) · 200 (30%) · 100 (10%). El mapeo paleta↔facultad fue reconstruido por Claude Design desde la geometría de la diapositiva de paletas del PPTX; ver planning/07-decisions-and-open-questions.md D-Q4 (pendiente de verificación oficial).",
      "ingenieria": { "700": "#63261E", "500": "#7F4738", "300": "#B29188", "200": "#D9C8C3", "100": "#F2EDEB" },
      "comportamiento": { "700": "#5E2B50", "500": "#7C4277", "300": "#B08EAD", "200": "#D8C6D6", "100": "#F2ECF1" },
      "educacion": { "700": "#0497AA", "500": "#69C2D1", "300": "#A5DAE3", "200": "#D2EDF1", "100": "#F0F9FA" },
      "medicina": { "700": "#CE960B", "500": "#F4C811", "300": "#F8DE70", "200": "#FCEEB8", "100": "#FEF9E7" },
      "juridicas": { "700": "#A30C0C", "500": "#CE2929", "300": "#E27E7E", "200": "#F0BFBF", "100": "#FAEAEA" },
      "cta": { "700": "#91734A", "500": "#BA9965", "300": "#D6C2A3", "200": "#EAE0D1", "100": "#F8F5F0" },
      "lenguas": { "700": "#5E1030", "500": "#842A4B", "300": "#B57F93", "200": "#DABFC9", "100": "#F3EAED" },
      "vida": { "700": "#9B928C", "500": "#BFB8B2", "300": "#D8D4D1", "200": "#ECEAE8", "100": "#F9F8F7" },
      "filosofia": { "700": "#004E8E", "500": "#1D6CBC", "300": "#77A7D7", "200": "#BBD3EB", "100": "#E8F0F8" },
      "comunicacion": { "700": "#546B70", "500": "#708E99", "300": "#A9BBC2", "200": "#D4DDE0", "100": "#F1F4F5" },
      "familia": { "700": "#788C31", "500": "#A1B945", "300": "#C7D58F", "200": "#E3EAC7", "100": "#F6F8EC" },
      "forum": { "700": "#28285B", "500": "#433D80", "300": "#8E8BB3", "200": "#C7C5D9", "100": "#ECECF2" },
      "economicas": { "700": "#BA550F", "500": "#E27614", "300": "#EEAD72", "200": "#F6D6B9", "100": "#FCF1E8" }
    },
    "facultyAccentMapping": {
      "_note": "Qué peso de la paleta de facultad ocupa cada rol --accent* al activar data-faculty. Extraído literalmente de tokens/colors.css líneas 60-72.",
      "ingenieria": { "accent": "500", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "comportamiento": { "accent": "500", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "educacion": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "medicina": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "juridicas": { "accent": "500", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "cta": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "lenguas": { "accent": "500", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "vida": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "filosofia": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "comunicacion": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "familia": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "forum": { "accent": "500", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" },
      "economicas": { "accent": "700", "accent-dark": "700", "accent-mid": "500", "accent-300": "300", "accent-100": "100" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "\"Libre Franklin\", \"Helvetica Neue\", Arial, sans-serif",
      "display": { "ref": "typography.fontFamily.sans" },
      "_note": "Única familia tipográfica permitida en todo el sistema. Publico Banner y Cabinet Grotesk aparecen en el brand book como caras secundarias pero no se usan por directiva institucional (ver readme.md §CAVEATS)."
    },
    "weights": {
      "thin": 100, "extralight": 200, "light": 300, "regular": 400,
      "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900
    },
    "scale": {
      "_note": "rem, 1rem = 16px. Escala calibrada para legibilidad de sala/proyección (ver readme.md §ACCESIBILIDAD).",
      "display": { "rem": 6, "px": 96, "use": "cifras hero / títulos de portada" },
      "h1": { "rem": 4, "px": 64 },
      "h2": { "rem": 3, "px": 48 },
      "h3": { "rem": 2.125, "px": 34 },
      "h4": { "rem": 1.625, "px": 26 },
      "lead": { "rem": 1.5, "px": 24, "use": "intro / párrafo guía" },
      "body": { "rem": 1.25, "px": 20, "use": "mínimo de cuerpo legible — nunca reducir por debajo de esto" },
      "small": { "rem": 1.0625, "px": 17 },
      "caption": { "rem": 0.875, "px": 14, "use": "pies, fuentes, etiquetas" }
    },
    "lineHeight": { "tight": 1.05, "heading": 1.15, "snug": 1.35, "body": 1.55 },
    "letterSpacing": { "display": "-0.02em", "heading": "-0.01em", "body": "0", "label": "0.14em" }
  },
  "spacing": {
    "scale": {
      "space-1": "0.25rem", "space-2": "0.5rem", "space-3": "0.75rem", "space-4": "1rem",
      "space-5": "1.5rem", "space-6": "2rem", "space-7": "3rem", "space-8": "4rem", "space-9": "6rem"
    },
    "radii": { "sm": "4px", "md": "8px", "lg": "16px", "pill": "999px" },
    "borders": { "width": "1px", "accentWidth": "3px" },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 32, 91, 0.08)",
      "md": "0 6px 18px rgba(0, 32, 91, 0.10)",
      "lg": "0 18px 48px rgba(0, 32, 91, 0.14)"
    },
    "canvas": { "width": 1280, "height": 720, "aspectRatio": "16 / 9", "margin": "72px", "gap": "32px" },
    "motion": {
      "easeStandard": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "durationFast": "140ms",
      "durationMedium": "260ms"
    }
  },
  "fonts": {
    "libreFranklin": {
      "source": "Google Fonts CDN",
      "importUrl": "https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap",
      "license": "SIL Open Font License (Google Fonts) — confirmar redistribución empaquetada antes de publicación externa, ver planning/07-decisions-and-open-questions.md D-Q3",
      "offlineNote": "Para el renderer HTML autocontenido (Hito 5) esta fuente debe embeberse (WOFF2 local en base64/@font-face), no depender de este import CDN, para cumplir el requisito de funcionamiento sin conexión (ver planning/06-security-and-governance.md, política de red)."
    }
  }
}
